      "parameters": {
        "jsCode": "// Get the audio URL from the previous node\nconst audioUrl = $input.item.json.audio_serve_url; \n\n// Prepare the data to be passed to the next node\n// This example assumes you want to pass the URL and the cleaned filename\nreturn [{\n  json: {\n    audioUrl: audioUrl, // Keep the full URL if you need it later\n    cleanedFilename: $('Start').first().json.output_title,\n  },\n  // To handle the binary data, you'll need to fetch the file in the next step.\n  // The 'data' property is where the binary data would go if you were handling it directly here.\n  // For Google Drive upload, it's better to use an HTTP Request node to download.\n}];"
      },
